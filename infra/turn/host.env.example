# Meshly TURN: host-side settings for host-setup.sh and meshly-turn-nat.sh.
# Fill from the discovery output, agree with Faisal, save as .secrets/host.env,
# then copy to /root/meshly/host.env on the Proxmox host (chmod 600).

# Container
CTID=120                      # from 'pvesh get /cluster/nextid'; must not exist
CT_HOSTNAME=meshly-turn
STORAGE=local-lvm             # rootfs storage from 'pvesm status'
TEMPLATE_STORAGE=local        # storage that holds templates (vztmpl content)
TEMPLATE=debian-12-standard_VERSION_amd64.tar.zst   # replace with the exact latest Debian name from 'pveam available --section system'
ROOTFS_GB=4
MEMORY_MB=512
SWAP_MB=256
CORES=1

# Private bridge for the container (must not collide with any existing subnet)
BRIDGE=vmbr1
BRIDGE_IP=10.10.10.1
PREFIX=24
SUBNET=10.10.10.0/24
CT_IP=10.10.10.20

# Public side (never modified by the scripts)
PUBLIC_IF=vmbr0
PUBLIC_IP=203.0.113.10        # placeholder; the host's public IPv4

# Ports
RELAY_MIN=49160
RELAY_MAX=49660
TLS_PUBLIC_PORT=443           # public TCP port forwarded to coturn 5349
FORWARD_HTTP_80=yes           # forward TCP 80 to the container for Let's Encrypt HTTP-01; set no if host uses 80
