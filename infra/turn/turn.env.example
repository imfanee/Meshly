# Meshly TURN: container-side settings for container-setup.sh.
# Save as .secrets/turn.env (never commit). Pushed into the container as /root/turn.env,
# which the setup script shreds after use.

TURN_DOMAIN=turn.example.com
PUBLIC_IP=203.0.113.10
CT_IP=10.10.10.20
ACME_EMAIL=you@example.com

# 64 hex chars from a CSPRNG, identical in meshly-config.php on cPanel.
# PowerShell: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })  (prefer: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
TURN_SECRET=REPLACE_WITH_64_HEX_CHARS

RELAY_MIN=49160
RELAY_MAX=49660

# coturn bandwidth limits are in BYTES per second
# 31250000 B/s = 250 Mbit/s total (half of the 500 Mbit/s link)
BPS_CAPACITY=31250000
# 375000 B/s = 3 Mbit/s per session (camera plus screen share headroom)
MAX_BPS=375000
