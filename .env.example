# Meshly public configuration (NOT secrets).
# Copy to app/.env.production and app/.env (dev) and adjust.
# Every value here ends up in the client bundle, so never put secrets here.

# Public URL of the deployed app (no trailing slash)
VITE_APP_URL=https://meshly.example.com

# Path of the TURN credential endpoint on the same origin
VITE_TURN_CREDENTIALS_PATH=/api/turn.php

# Free public STUN servers, comma-separated (keep to 2 or 3; more slows ICE gathering)
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478

# Own STUN on the coturn box, appended once the TURN relay is live (leave empty until then)
VITE_OWN_STUN_URL=

# Signalling: Nostr relays (verified in spike T0.3), comma-separated
VITE_NOSTR_RELAYS=wss://relay.primal.net,wss://nos.lol,wss://nostr.mom,wss://nostr.oxtr.dev

# Signalling: MQTT over WebSocket brokers (verified in spike T0.4), comma-separated
VITE_MQTT_BROKERS=wss://broker.emqx.io:8084/mqtt,wss://broker.hivemq.com:8884/mqtt

# Development only: local WebSocket relay used by e2e tests (never set in production)
VITE_DEV_RELAY_URL=

# Limits
VITE_MAX_PARTICIPANTS=12
VITE_MAX_VIDEO=6

# Staged ICE: escalate to TURN if a pair is not connected within this many ms
VITE_ICE_ESCALATE_MS=8000
