# Normalise text files to LF in the repo
* text=auto eol=lf

# Must be LF on disk too (run on Linux / Apache)
*.sh        text eol=lf
*.conf      text eol=lf
*.template  text eol=lf
*.service   text eol=lf
*.php       text eol=lf
.htaccess   text eol=lf

# Windows-only scripts
*.ps1       text eol=crlf
*.cmd       text eol=crlf

# Binary
*.png   binary
*.jpg   binary
*.webp  binary
*.ico   binary
*.woff2 binary
*.mp3   binary
*.wav   binary
